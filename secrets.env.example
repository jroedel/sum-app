# Every secret and setting this machine needs to test and deploy sum-app.
#
# Copy to secrets.env (gitignored), chmod 600, and fill in. Keep the whole
# file as one note in your password vault: with this repository and that note,
# a new machine reaches a tested, deployable state (docs/13-ci-cd.md).
#
# KEY=VALUE, one per line, taken literally: no quotes, no $ expansion. Every
# value is a single line; keys are base64 for that reason.
#
# make secrets-check says what is missing, and never shows a value.

# --- GitHub secrets (make secrets-push), production environment ---------------

# The konsoleH account's ssh details: konsoleH > Access > SSH.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22

# Filled in by make secrets-keygen: the deploy key (base64), which can only
# reach deploy/receive.sh, and the server's host key, pinned (base64).
DEPLOY_SSH_KEY_B64=
DEPLOY_KNOWN_HOSTS_B64=

# --- GitHub variables (make secrets-push), nothing secret ---------------------

APP_HOST=app.sumatx.us
# A free loopback port on the shared account: make prod-ports lists them.
APP_PORT=
# The app's directory, relative to the account's home. Outside public_html.
APP_DIR=sum-app
# The addon domain's document root, relative to the home (deploy/README.md).
APP_DOCROOT=public_html/app.sumatx.us/public

# --- This machine only ---------------------------------------------------------

# Your own ssh host alias for the account (in ~/.ssh/config), used by
# make prod-install, secrets-install and prod-logs. Never the deploy key.
PROD_SSH=

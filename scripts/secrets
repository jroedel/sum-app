#!/usr/bin/env bash
#
# One secrets.env, three destinations (docs/13-ci-cd.md, "Secrets").
#
#     scripts/secrets check            every key present, the file private; nothing printed
#     scripts/secrets template-check   secrets.env.example and the lists below agree (CI runs this)
#     scripts/secrets keygen           mint the deploy key, pin the server's host key
#     scripts/secrets push             the deploy block to GitHub: secrets and variables
#     scripts/secrets install          config.toml to the server, over the person's own ssh
#     scripts/secrets render           print the config.toml that install would send
#
# Through make (secrets-check, secrets-keygen, ...), by a person at a terminal.
# Agents never run push, install or keygen, and never read secrets.env
# (CLAUDE.md section 6; .claude/settings.json denies them).
#
# Each key goes where its list says, and a key on no list goes nowhere; check
# names it. A value is never printed by any command here.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# shellcheck source=scripts/env-lib.sh
source scripts/env-lib.sh

# GitHub secrets, in the production environment: what the deploy needs to
# reach the receiver, and nothing else.
DEPLOY_KEYS=(DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT DEPLOY_SSH_KEY_B64 DEPLOY_KNOWN_HOSTS_B64)

# GitHub variables, repository-level: nothing secret, readable in a log, which
# is what makes a failed deploy debuggable.
VAR_KEYS=(APP_HOST APP_PORT APP_DIR APP_DOCROOT)

# This machine only: none today. (A PROD_SSH alias was here briefly; the
# person's commands now reach the server with DEPLOY_SSH_HOST, _USER and _PORT
# and their own ssh keys, as in the sibling projects.)
LOCAL_KEYS=()

# Runtime credentials, to config.toml on the server and never to GitHub. None
# yet: Twilio, the drop-in forms key and the signing key arrive with the
# features that use them, each as a line here and a line in render.
RUNTIME_KEYS=()

ALL_KEYS=("${DEPLOY_KEYS[@]}" "${VAR_KEYS[@]}" "${LOCAL_KEYS[@]}" "${RUNTIME_KEYS[@]}")

# ------------------------------------------------------------------ check

cmd_check() {
	[ -f "$ENV_FILE" ] || {
		echo "there is no $ENV_FILE. Copy secrets.env.example to it, or paste the vault note into it" >&2
		exit 1
	}

	local mode
	mode="$(stat -c '%a' "$ENV_FILE")"
	if [ "$mode" != 600 ]; then
		echo "$ENV_FILE is mode $mode; run chmod 600 $ENV_FILE" >&2
		exit 1
	fi

	load_env

	local status=0 key
	need "${ALL_KEYS[@]}" || status=1

	for key in "${!ENV[@]}"; do
		if [[ ! " ${ALL_KEYS[*]} " == *" $key "* ]]; then
			echo "$key is on no list in scripts/secrets, so it goes nowhere" >&2
			status=1
		fi
	done

	# APP_PORT, checked here as well as by the binary, so the mistake is found
	# on this machine before anything is sent. The first deploy failed on
	# APP_PORT=222, the account's SSH port, which no account may listen on.
	local app_port="${ENV[APP_PORT]:-}"
	if [ -n "$app_port" ]; then
		if ! [[ "$app_port" =~ ^[0-9]+$ ]] || [ "$app_port" -lt 1024 ] || [ "$app_port" -gt 65535 ]; then
			echo "APP_PORT is $app_port; it must be a free port from 1024 to 65535 (make prod-ports lists some)" >&2
			status=1
		elif [ "$app_port" = "${ENV[DEPLOY_SSH_PORT]:-}" ]; then
			echo "APP_PORT is the same as DEPLOY_SSH_PORT; APP_PORT is the loopback port the app listens on, not the SSH port (make prod-ports lists free ones)" >&2
			status=1
		fi
	fi

	if [ "$status" = 0 ]; then
		echo "every key is present"
	fi

	# The vault copy is the backup (docs/13-ci-cd.md, "The password vault").
	# A fingerprint, not the file, so the two copies can be compared at a
	# glance without either being shown.
	echo "fingerprint $(sha256sum "$ENV_FILE" | cut -c1-12): if this changed, update the vault note"

	return "$status"
}

# The example is the documentation of every key; this keeps it honest.
cmd_template_check() {
	local example=secrets.env.example key status=0
	local in_example
	in_example="$(sed -n 's/^\([A-Z][A-Z0-9_]*\)=.*/\1/p' "$example" | sort)"

	for key in "${ALL_KEYS[@]}"; do
		grep -qx "$key" <<<"$in_example" || { echo "$example does not document $key" >&2; status=1; }
	done
	for key in $in_example; do
		[[ " ${ALL_KEYS[*]} " == *" $key "* ]] || { echo "$example documents $key, which no list in scripts/secrets sends anywhere" >&2; status=1; }
	done

	[ "$status" = 0 ] && echo "secrets.env.example documents exactly the keys scripts/secrets knows"
	return "$status"
}

# ------------------------------------------------------------------ keygen

cmd_keygen() {
	load_env
	need DEPLOY_SSH_HOST DEPLOY_SSH_PORT

	# Global, not local: the EXIT trap runs after this function has returned,
	# when a local would be gone, and under set -u the trap then fails
	# instead of cleaning up. That left a copy of the deploy key in /tmp
	# the first time make secrets-keygen ran.
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT

	if [ -n "${ENV[DEPLOY_SSH_KEY_B64]:-}" ] && [ "${FORCE:-}" != 1 ]; then
		echo "there is already a deploy key; keeping it (FORCE=1 make secrets-keygen mints a new one)"
	else
		ssh-keygen -q -t ed25519 -N '' -C sum-app-deploy -f "$tmp/key"
		set_env DEPLOY_SSH_KEY_B64 "$(base64 -w0 "$tmp/key")"
		echo "minted a new deploy key; make prod-install puts it on the server behind the receiver"
	fi

	# The host key, pinned, so the deploy never trusts whatever answers.
	ssh-keyscan -t ed25519 -p "${ENV[DEPLOY_SSH_PORT]}" "${ENV[DEPLOY_SSH_HOST]}" >"$tmp/known_hosts" 2>/dev/null
	[ -s "$tmp/known_hosts" ] || {
		echo "could not read ${ENV[DEPLOY_SSH_HOST]}'s host key; check DEPLOY_SSH_HOST and DEPLOY_SSH_PORT" >&2
		exit 1
	}
	set_env DEPLOY_KNOWN_HOSTS_B64 "$(base64 -w0 "$tmp/known_hosts")"

	echo "pinned the server's host key. Compare its fingerprint with the one konsoleH shows:"
	ssh-keygen -lf "$tmp/known_hosts"
	echo "then update the vault note."
}

# ------------------------------------------------------------------ push

cmd_push() {
	on_latest_main || exit 1
	load_env
	need "${DEPLOY_KEYS[@]}" "${VAR_KEYS[@]}"

	local key
	for key in "${DEPLOY_KEYS[@]}"; do
		# On standard input, never --body: a value on a command line is in
		# ps, and stewards' `--body -` once stored a literal "-" in every
		# secret while its check still passed.
		printf '%s' "${ENV[$key]}" | gh secret set "$key" --env production
	done
	for key in "${VAR_KEYS[@]}"; do
		gh variable set "$key" --body "${ENV[$key]}"
	done

	# Read back, because a set that silently did nothing is the failure the
	# deploy would otherwise report, later and less clearly. GitHub's list
	# can lag a moment behind a set.
	local listed missing=()
	for _ in 1 2 3 4 5; do
		listed="$(gh secret list --env production --json name --jq '.[].name'; gh variable list --json name --jq '.[].name')"
		missing=()
		for key in "${DEPLOY_KEYS[@]}" "${VAR_KEYS[@]}"; do
			grep -qx "$key" <<<"$listed" || missing+=("$key")
		done
		[ "${#missing[@]}" -eq 0 ] && break
		sleep 3
	done

	if [ "${#missing[@]}" -gt 0 ]; then
		echo "GitHub does not list: ${missing[*]}" >&2
		exit 1
	fi

	echo "GitHub has every deploy secret (production environment) and variable"
}

# ------------------------------------------------------------------ render and install

cmd_render() {
	load_env
	need APP_PORT APP_HOST
	cat <<EOF
# Written by make secrets-install from secrets.env. Edit secrets.env and run
# it again rather than editing this file: the next install replaces it.

[server]
addr = "127.0.0.1:${ENV[APP_PORT]}"
base_url = "https://${ENV[APP_HOST]}"

[log]
level = "info"
EOF
}

cmd_install() {
	on_latest_main || exit 1
	load_env
	need DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT APP_DIR APP_PORT APP_HOST

	local dir="${ENV[APP_DIR]}"

	# Written beside the live one, checked by the running binary when there
	# is one, and only then moved into place.
	cmd_render | prod_ssh "umask 077 && mkdir -p '$dir' && cat > '$dir/config.toml.new'"

	prod_ssh "cd '$dir' && if [ -x ./sum-app ]; then ./sum-app -config config.toml.new -check; else echo 'no binary yet; the first deploy checks this config'; fi" ||
		{
			echo "the live binary refuses the new config.toml; it was not installed" >&2
			exit 1
		}

	prod_ssh "cd '$dir' && mv config.toml.new config.toml && if [ -x ./supervise.sh ] && ./supervise.sh status >/dev/null 2>&1; then ./supervise.sh restart; fi"
	echo "config.toml is installed in $dir"
}

case "${1:-}" in
check) cmd_check ;;
template-check) cmd_template_check ;;
keygen) cmd_keygen ;;
push) cmd_push ;;
render) cmd_render ;;
install) cmd_install ;;
*)
	echo "usage: scripts/secrets {check|template-check|keygen|push|render|install}" >&2
	exit 2
	;;
esac
